# ---- SMTP (example uses Gmail; create an App Password at myaccount.google.com/apppasswords) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Kestrel Bank <youraddress@gmail.com>"

# ---- Default OTP address ----
# If the person types anything that is not an email (mobile number, account number...),
# the OTP is sent here. If they type an email, the OTP goes to that email instead.
DEFAULT_OTP_EMAIL=anujpanjiyar@gmail.com

# ---- Misc ----
PORT=3000
